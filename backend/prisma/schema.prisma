generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  username     String           @unique
  email        String?          @unique
  passwordHash String
  createdAt    DateTime         @default(now())

  tripsOwned   Trip[]           @relation("TripOwner")
  memberships  TripMember[]
  expenses     Expense[]        @relation("UserCreatedExpenses")
  splits       ExpenseSplit[]
  payments     ExpensePayment[]
}

model Trip {
  id        String       @id @default(cuid())
  name      String
  ownerId   String
  owner     User         @relation("TripOwner", fields: [ownerId], references: [id])
  createdAt DateTime     @default(now())

  members   TripMember[]
  expenses  Expense[]
}

model TripMember {
  id      String @id @default(cuid())
  tripId  String
  userId  String
  role    String @default("member")
  joinedAt DateTime @default(now())

  trip    Trip   @relation(fields: [tripId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@unique([tripId, userId])
}

model Expense {
  id            String        @id @default(cuid())
  tripId        String
  createdById   String
  description   String
  category      String?
  expenseType   String?
  quantity      Int?          @default(1)
  unitPriceCents Int?
  amountCents   Int
  incurredAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())

  trip         Trip          @relation(fields: [tripId], references: [id])
  createdBy    User          @relation("UserCreatedExpenses", fields: [createdById], references: [id])
  splits       ExpenseSplit[]
  payments     ExpensePayment[]
}

model ExpenseSplit {
  id         String  @id @default(cuid())
  expenseId  String
  userId     String
  amountCents Int

  expense   Expense @relation(fields: [expenseId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model ExpensePayment {
  id          String @id @default(cuid())
  expenseId   String
  userId      String
  amountCents Int

  expense   Expense @relation(fields: [expenseId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
}
